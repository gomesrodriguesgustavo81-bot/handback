# Copie este arquivo para ".env.local" e preencha com os dados do seu projeto Supabase
# (Supabase › Project Settings › API). Na Vercel, cadastre as mesmas variáveis em
# Settings › Environment Variables.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# --- Recebimento de entregas por e-mail (só no servidor; NUNCA com NEXT_PUBLIC_) ---
# Chave secreta do Supabase (Project Settings › API Keys › secret). A integração
# Supabase + Vercel já cria esta variável sozinha (SUPABASE_SECRET_KEY ou SUPABASE_SERVICE_ROLE_KEY).
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx
# Senha longa e aleatória que o serviço de recebimento usa para chamar o Handback:
#   POST https://SEU-SITE/api/emails/entrada?chave=ESTA_SENHA
HANDBACK_EMAIL_SEGREDO=troque-por-uma-senha-longa-e-aleatoria
# Endereço base do serviço de recebimento. Cada empresa recebe em "entregas+CODIGO@…".
HANDBACK_EMAIL_RECEBIMENTO=entregas@seu-servico-de-recebimento.com

# --- Análise com IA (só no servidor) ---
# Chave do Gemini (aistudio.google.com/apikey). Use uma chave com faturamento ativo:
# no plano gratuito o Google pode usar os dados enviados para melhorar os produtos dele.
GEMINI_API_KEY=sua-chave-do-gemini
# Modelo preferido (opcional). Se faltar cota, o Handback tenta gemini-flash-latest e gemini-flash-lite-latest.
HANDBACK_IA_MODELO=gemini-flash-latest
